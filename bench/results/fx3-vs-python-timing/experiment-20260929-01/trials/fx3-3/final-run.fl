(defn order-total [$order]
  (let [$subtotal (get $order "subtotal")
        $shipping (get $order "shipping")]
    (if (>= $subtotal 5000)
      $subtotal
      (+ $subtotal $shipping))))
(println (order-total {"subtotal" 4200 "shipping" 300}))
(println (order-total {"subtotal" 5000 "shipping" 300}))
(println (order-total {"subtotal" 9999 "shipping" 500}))
(println (order-total {"subtotal" 0 "shipping" 0}))
