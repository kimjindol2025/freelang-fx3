F validate-manifest[$m]{$ks=keys($m);$n=length($ks);$name=@$m.name;$version=@$m.version;$language=@$m.language;$tasks=@$m.tasks;?$n>4{{ok:false,code:"E_UNKNOWN_KEY",field:get($ks,4),message:"unknown key"}}{?(?0>=$n{1}{?get($ks,0)=="name"{1}{?get($ks,0)=="version"{1}{?get($ks,0)=="language"{1}{?get($ks,0)=="tasks"{1}{0}}}}}){?(?1>=$n{1}{?get($ks,1)=="name"{1}{?get($ks,1)=="version"{1}{?get($ks,1)=="language"{1}{?get($ks,1)=="tasks"{1}{0}}}}}){?(?2>=$n{1}{?get($ks,2)=="name"{1}{?get($ks,2)=="version"{1}{?get($ks,2)=="language"{1}{?get($ks,2)=="tasks"{1}{0}}}}}){?(?3>=$n{1}{?get($ks,3)=="name"{1}{?get($ks,3)=="version"{1}{?get($ks,3)=="language"{1}{?get($ks,3)=="tasks"{1}{0}}}}}){?~$name{{ok:false,code:"E_REQUIRED",field:"name",message:"name is required"}}{?type-of($name)=="string"{?str_length($name)>0{?~$version{{ok:false,code:"E_REQUIRED",field:"version",message:"version is required"}}{?type-of($version)=="string"{?$version>="1.0.0"{?$version<"2.0.0"{?~$language{{ok:false,code:"E_REQUIRED",field:"language",message:"language is required"}}{?type-of($language)=="string"{?$language=="fx3"{?~$tasks{{ok:false,code:"E_REQUIRED",field:"tasks",message:"tasks is required"}}{?type-of($tasks)=="array"{?length($tasks)>0{{ok:true,name:$name,version:$version,language:$language,tasks:$tasks}}{{ok:false,code:"E_EMPTY_TASKS",field:"tasks",message:"tasks must not be empty"}}}{{ok:false,code:"E_BAD_TYPE",field:"tasks",message:"tasks must be an array"}}}}{{ok:false,code:"E_BAD_VALUE",field:"language",message:"language must be fx3"}}}{{ok:false,code:"E_BAD_TYPE",field:"language",message:"language must be a string"}}}}{{ok:false,code:"E_BAD_VERSION",field:"version",message:"version must be >=1.0.0 and <2.0.0"}}}{{ok:false,code:"E_BAD_VERSION",field:"version",message:"version must be >=1.0.0 and <2.0.0"}}}{{ok:false,code:"E_BAD_TYPE",field:"version",message:"version must be a string"}}}}{{ok:false,code:"E_BAD_VALUE",field:"name",message:"name must not be empty"}}}{{ok:false,code:"E_BAD_TYPE",field:"name",message:"name must be a string"}}}}{{ok:false,code:"E_UNKNOWN_KEY",field:get($ks,3),message:"unknown key"}}}{{ok:false,code:"E_UNKNOWN_KEY",field:get($ks,2),message:"unknown key"}}}{{ok:false,code:"E_UNKNOWN_KEY",field:get($ks,1),message:"unknown key"}}}{{ok:false,code:"E_UNKNOWN_KEY",field:get($ks,0),message:"unknown key"}}};}
