F lint-config[$m]{$ks=keys($m);$n=length($ks);$name=@$m.name;$env=@$m.env;$port=@$m.port;$debug=@$m.debug;?$n>4{{ok:false,code:"E_UNKNOWN_KEY",field:get($ks,4),message:"unknown key"}}{?(?0>=$n{1}{?get($ks,0)=="name"{1}{?get($ks,0)=="env"{1}{?get($ks,0)=="port"{1}{?get($ks,0)=="debug"{1}{0}}}}}){?(?1>=$n{1}{?get($ks,1)=="name"{1}{?get($ks,1)=="env"{1}{?get($ks,1)=="port"{1}{?get($ks,1)=="debug"{1}{0}}}}}){?(?2>=$n{1}{?get($ks,2)=="name"{1}{?get($ks,2)=="env"{1}{?get($ks,2)=="port"{1}{?get($ks,2)=="debug"{1}{0}}}}}){?(?3>=$n{1}{?get($ks,3)=="name"{1}{?get($ks,3)=="env"{1}{?get($ks,3)=="port"{1}{?get($ks,3)=="debug"{1}{0}}}}}){?~$name{{ok:false,code:"E_REQUIRED",field:"name",message:"name is required"}}{?type-of($name)=="string"{?str_length($name)>0{?~$env{{ok:false,code:"E_REQUIRED",field:"env",message:"env is required"}}{?type-of($env)=="string"{?(?$env=="dev"{1}{?$env=="prod"{1}{?$env=="test"{1}{0}}}){?~$port{{ok:false,code:"E_REQUIRED",field:"port",message:"port is required"}}{?type-of($port)=="number"{?$port>=1{?$port<=65535{?~$debug{{ok:false,code:"E_REQUIRED",field:"debug",message:"debug is required"}}{?type-of($debug)=="boolean"{{ok:true,name:$name,env:$env,port:$port,debug:$debug}}{{ok:false,code:"E_BAD_TYPE",field:"debug",message:"debug must be a boolean"}}}}{{ok:false,code:"E_BAD_PORT",field:"port",message:"port must be 1..65535"}}}{{ok:false,code:"E_BAD_PORT",field:"port",message:"port must be 1..65535"}}}{{ok:false,code:"E_BAD_TYPE",field:"port",message:"port must be a number"}}}}{{ok:false,code:"E_BAD_VALUE",field:"env",message:"env must be dev|prod|test"}}}{{ok:false,code:"E_BAD_TYPE",field:"env",message:"env must be a string"}}}}{{ok:false,code:"E_BAD_VALUE",field:"name",message:"name must not be empty"}}}{{ok:false,code:"E_BAD_TYPE",field:"name",message:"name must be a string"}}}}{{ok:false,code:"E_UNKNOWN_KEY",field:get($ks,3),message:"unknown key"}}}{{ok:false,code:"E_UNKNOWN_KEY",field:get($ks,2),message:"unknown key"}}}{{ok:false,code:"E_UNKNOWN_KEY",field:get($ks,1),message:"unknown key"}}}{{ok:false,code:"E_UNKNOWN_KEY",field:get($ks,0),message:"unknown key"}}};}
